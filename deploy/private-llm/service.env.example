# The key itself is never stored here or in Git.
PRIVATE_LLM_TOKEN_FILE=/etc/ai-private-llm/token
PRIVATE_LLM_PORT=18804
PRIVATE_LLM_OLLAMA_URL=http://127.0.0.1:11435
PRIVATE_LLM_MODEL=qwen2.5:0.5b
PRIVATE_LLM_CONTEXT=2048
PRIVATE_LLM_MAX_OUTPUT=256
PRIVATE_LLM_RPM=8
PRIVATE_LLM_CONCURRENCY=1
PRIVATE_LLM_QUEUE_CAPACITY=4
PRIVATE_LLM_QUEUE_TIMEOUT_MS=120000
PRIVATE_LLM_TIMEOUT_MS=120000
