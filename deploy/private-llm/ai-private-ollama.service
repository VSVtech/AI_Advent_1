[Unit]
Description=Private local Ollama for AI Challenge
After=network.target

[Service]
Type=simple
User=ai-llm
Group=ai-llm
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_MODELS=/var/lib/ai-private-llm/models
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_MAX_QUEUE=2
Environment=OLLAMA_CONTEXT_LENGTH=2048
Environment=OLLAMA_KEEP_ALIVE=5m
ExecStart=/opt/ai-private-llm/runtime/bin/ollama serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
MemoryMax=1200M
CPUQuota=75%
TasksMax=128
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/ai-private-llm
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
